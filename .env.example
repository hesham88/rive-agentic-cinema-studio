# Copy to .env and fill in. .env is gitignored and must never be committed.
GEMINI_API_KEY=your-google-ai-studio-key
PARALLEL_API_KEY=your-parallel-search-key

# Firebase client config — production only, and NOT secret. These ship to the
# browser by design; access is controlled by Firebase security rules and
# authorised domains. Local development needs none of them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Point the client at the local auth emulator instead of real accounts.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
