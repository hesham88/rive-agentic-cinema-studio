__pycache__/
*.egg-info/
*.pyc
.venv/

# ---------------------------------------------------------------------------
# Private — never publish. This repo is public; git history is permanent.
# ---------------------------------------------------------------------------

# Secrets and credentials
.env
.env.*
!.env.example
*.key
*.pem
*credentials*
*secret*
# ...but the guard script itself must ship, or a fresh clone has a
# pre-commit hook pointing at a file that does not exist.
!scripts/check-credentials.sh
service-account*.json
gcp-*.json

# Local agent tooling — see .git/info/exclude for machine-specific paths
.remember/
AGENTS.md
GEMINI.md
.cursor/
.cursorrules
.github/copilot-instructions.md

# Internal operations: owner identity, working agreements, request log
_OPERATIONS/

# Scratch
.out/
scratchpad/
*.local

# next static export
apps/studio/out/
.firebase/

# Playwright's UI capture output. Diagnostic, regenerated on demand, and
# large — the repo is not where design screenshots belong.
apps/studio/ui-shots/
apps/studio/test-results/
