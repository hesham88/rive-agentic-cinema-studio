{
  "name": "rive-engine-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest --root packages/rive-engine",
    "typecheck": "tsc --noEmit -p packages/rive-engine && tsc --noEmit -p apps/studio/tsconfig.json",
    "dev": "npm run dev --workspace apps/studio",
    "build": "npm run build --workspace apps/studio",
    "test:e2e": "npx playwright test --config apps/studio/playwright.config.ts --project=local",
    "agent": "python -m genassets.agent.run",
    "emulate": "firebase emulators:start --project rive-agentic-studio",
    "preview": "npm run build && firebase emulators:start --only hosting --project rive-agentic-studio",
    "deploy": "npm run build && firebase deploy --only hosting --project rive-agentic-studio",
    "test:e2e:prod": "npx playwright test --config apps/studio/playwright.config.ts --project=production",
    "test:secrets": "bash scripts/test-check-credentials.sh",
    "test:py": "python -m pytest tools/genassets/tests -q",
    "predeploy": "bash scripts/preflight-deploy.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
